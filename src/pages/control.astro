<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>DUC Drivers MobilityOS — Preview V4 Olivia AI</title>
  <style>
    :root{
      --bg:#050711;
      --bg2:#080d1e;
      --panel:rgba(255,255,255,.074);
      --panel2:rgba(255,255,255,.115);
      --panel3:rgba(255,255,255,.16);
      --line:rgba(255,255,255,.14);
      --line2:rgba(255,255,255,.22);
      --text:#f7f9ff;
      --soft:#dfe6ff;
      --muted:#a8b1cf;
      --muted2:#7f8aaa;
      --gold:#ffd176;
      --green:#37e7a1;
      --blue:#70a7ff;
      --cyan:#63e8ff;
      --violet:#a785ff;
      --pink:#ff79b8;
      --orange:#ff9b63;
      --red:#ff647d;
      --shadow:0 28px 90px rgba(0,0,0,.50);
      --shadow2:0 18px 54px rgba(0,0,0,.34);
      --radius:30px;
      --radius2:22px;
      --radius3:16px;
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      color:var(--text);
      background:
        radial-gradient(circle at 9% 6%, rgba(102,72,255,.50), transparent 32%),
        radial-gradient(circle at 88% 8%, rgba(55,231,161,.22), transparent 31%),
        radial-gradient(circle at 58% 96%, rgba(255,209,118,.15), transparent 34%),
        linear-gradient(145deg,#03050c,#081127 43%,#050711);
      overflow-x:hidden;
    }
    body:before{
      content:"";
      position:fixed; inset:0; pointer-events:none; z-index:-1;
      background-image:
        linear-gradient(rgba(255,255,255,.032) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.032) 1px, transparent 1px);
      background-size:42px 42px;
      mask-image:linear-gradient(to bottom, rgba(0,0,0,.95), transparent 84%);
    }
    body:after{
      content:"";
      position:fixed; inset:auto -12% -25% -12%; height:52vh; pointer-events:none; z-index:-1;
      background:radial-gradient(ellipse at center, rgba(99,232,255,.12), transparent 58%);
      filter:blur(8px);
    }
    a{color:inherit;text-decoration:none}
    button{font:inherit}
    .shell{width:min(1480px,calc(100% - 36px)); margin:0 auto; padding:22px 0 80px}
    .topbar{
      position:sticky; top:14px; z-index:50;
      display:flex; align-items:center; justify-content:space-between; gap:16px;
      padding:12px 14px; border:1px solid var(--line);
      border-radius:999px; background:rgba(5,7,17,.72); backdrop-filter:blur(24px);
      box-shadow:var(--shadow2);
    }
    .brand{display:flex;align-items:center;gap:12px;min-width:max-content}
    .logo{
      width:44px;height:44px;border-radius:15px;display:grid;place-items:center;font-weight:1000;letter-spacing:-.08em;
      background:linear-gradient(135deg,var(--gold),var(--orange) 45%,var(--pink)); color:#11101a;
      box-shadow:0 12px 34px rgba(255,209,118,.25);
    }
    .brand-title{font-weight:900;letter-spacing:-.04em;line-height:1}
    .brand-sub{font-size:12px;color:var(--muted);margin-top:3px}
    .nav{display:flex;gap:6px;align-items:center;justify-content:center;flex-wrap:wrap}
    .nav a{
      padding:10px 12px;border:1px solid transparent;border-radius:999px;color:var(--muted);font-size:13px;font-weight:800;
    }
    .nav a:hover{color:var(--text);border-color:var(--line);background:rgba(255,255,255,.06)}
    .menu-toggle{display:none;width:44px;height:44px;border:1px solid var(--line);border-radius:15px;background:rgba(255,255,255,.07);color:var(--text);cursor:pointer;place-items:center}
    .menu-toggle span,.menu-toggle:before,.menu-toggle:after{content:"";display:block;width:20px;height:2px;border-radius:999px;background:currentColor;transition:.2s ease}
    .menu-toggle{gap:4px}
    .menu-toggle[aria-expanded="true"] span{opacity:0}.menu-toggle[aria-expanded="true"]:before{transform:translateY(6px) rotate(45deg)}.menu-toggle[aria-expanded="true"]:after{transform:translateY(-6px) rotate(-45deg)}
    .top-actions{display:flex;align-items:center;gap:8px;min-width:max-content}
    .lang{display:flex;gap:5px;border:1px solid var(--line);background:rgba(255,255,255,.055);border-radius:999px;padding:5px}
    .lang button{border:0;background:transparent;cursor:pointer;font-size:11px;color:var(--muted);font-weight:900;padding:5px 7px;border-radius:999px}
    .lang button.active{background:rgba(255,255,255,.12);color:var(--text)}
    .btn{
      border:0; cursor:pointer; color:#0b0b11; font-weight:950;
      border-radius:999px; padding:12px 16px;
      background:linear-gradient(135deg,var(--gold),var(--green));
      box-shadow:0 16px 38px rgba(55,231,161,.16);
      white-space:nowrap;
    }
    .btn.dark{color:var(--text);background:rgba(255,255,255,.08);border:1px solid var(--line);box-shadow:none}
    .btn.blue{background:linear-gradient(135deg,var(--cyan),var(--blue));}

    .hero{display:grid;grid-template-columns:1.04fr .96fr; gap:26px; align-items:stretch; padding:70px 0 32px}
    .hero-copy{padding:38px;border-radius:var(--radius);border:1px solid var(--line);background:linear-gradient(155deg, rgba(255,255,255,.095), rgba(255,255,255,.045));box-shadow:var(--shadow);position:relative;overflow:hidden}
    .hero-copy:before{content:"";position:absolute;inset:-38% auto auto 40%;width:74%;height:88%;background:radial-gradient(circle,rgba(255,209,118,.18),transparent 60%);filter:blur(10px)}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.07);font-size:12px;text-transform:uppercase;letter-spacing:.11em;color:var(--soft);font-weight:1000}
    h1{font-size:clamp(44px,6.7vw,98px);line-height:.88;margin:26px 0 22px;letter-spacing:-.085em;max-width:980px}
    .gradient{background:linear-gradient(115deg,var(--gold),#fff 38%,var(--cyan) 68%,var(--violet));-webkit-background-clip:text;background-clip:text;color:transparent}
    .lead{font-size:clamp(18px,2.2vw,25px);color:var(--soft);line-height:1.42;max-width:820px;margin:0 0 26px}
    .lead strong{color:#fff}
    .hero-buttons{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0}
    .hero-pills{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:26px}
    .pill-card{padding:16px;border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.065)}
    .pill-card b{display:block;font-size:21px;letter-spacing:-.04em;margin-bottom:4px}.pill-card span{font-size:12px;color:var(--muted);font-weight:800}.pill-card small{display:block;color:var(--green);font-weight:950;margin-top:8px;font-size:12px}

    .hero-stage{position:relative;min-height:710px;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(160deg,rgba(255,255,255,.1),rgba(255,255,255,.045));box-shadow:var(--shadow);overflow:hidden;padding:24px}
    .hero-stage:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 78% 17%,rgba(99,232,255,.22),transparent 38%), radial-gradient(circle at 20% 90%,rgba(255,121,184,.18),transparent 35%)}
    .orb{position:absolute;border-radius:50%;filter:blur(.2px);opacity:.9}.orb.one{width:90px;height:90px;background:rgba(255,209,118,.23);right:36px;top:72px}.orb.two{width:130px;height:130px;background:rgba(55,231,161,.15);left:35px;bottom:90px}.orb.three{width:66px;height:66px;background:rgba(167,133,255,.24);right:120px;bottom:160px}
    .phone-stack{position:relative;z-index:2;height:100%;display:grid;place-items:center}
    .phone{
      width:min(350px,80vw);height:640px;border:1px solid rgba(255,255,255,.20);border-radius:48px;background:#070b17;box-shadow:0 48px 110px rgba(0,0,0,.55);padding:13px;position:relative;
      transform:rotate(-3deg);animation:floaty 7s ease-in-out infinite;
    }
    @keyframes floaty{0%,100%{transform:rotate(-3deg) translateY(0)}50%{transform:rotate(-1deg) translateY(-10px)}}
    .phone:before{content:"";position:absolute;top:9px;left:50%;transform:translateX(-50%);width:112px;height:25px;border-radius:0 0 18px 18px;background:#050711;z-index:4}
    .screen{height:100%;border-radius:38px;background:linear-gradient(180deg,#121a32,#070a14 48%,#0b1022);overflow:hidden;position:relative;padding:26px 17px 18px}
    .screen-map{position:absolute;inset:0;opacity:.38;background:
      linear-gradient(32deg,transparent 0 46%,rgba(255,255,255,.12) 47% 48%,transparent 49%),
      linear-gradient(122deg,transparent 0 42%,rgba(255,255,255,.11) 43% 44%,transparent 45%),
      radial-gradient(circle at 40% 40%,rgba(99,232,255,.35),transparent 15%),
      radial-gradient(circle at 70% 63%,rgba(55,231,161,.25),transparent 13%);
      background-size:100% 100%,100% 100%,100% 100%,100% 100%}
    .screen-content{position:relative;z-index:2}.phone-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.tiny-logo{display:flex;gap:8px;align-items:center;font-weight:950}.tiny-logo i{width:28px;height:28px;border-radius:10px;background:linear-gradient(135deg,var(--gold),var(--pink));display:block}.status{font-size:11px;color:var(--green);font-weight:1000;padding:6px 8px;background:rgba(55,231,161,.12);border:1px solid rgba(55,231,161,.22);border-radius:999px}
    .service-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.service-tabs span{font-size:11px;text-align:center;font-weight:950;padding:9px 6px;border-radius:999px;border:1px solid var(--line);background:rgba(255,255,255,.07);color:var(--muted)}.service-tabs span:first-child{background:linear-gradient(135deg,var(--gold),var(--green));color:#071014;border:0}
    .ride-card{margin-top:14px;border:1px solid var(--line);background:rgba(255,255,255,.09);border-radius:24px;padding:14px}.ride-line{display:flex;gap:10px;align-items:center;padding:10px 0}.dot{width:12px;height:12px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(55,231,161,.12)}.dot.end{background:var(--pink);box-shadow:0 0 0 5px rgba(255,121,184,.11)}.ride-line div{font-size:12px;color:var(--muted)}.ride-line b{display:block;font-size:14px;color:var(--text);margin-top:2px}.route{height:52px;width:2px;background:linear-gradient(var(--green),var(--pink));margin-left:5px;opacity:.75}
    .fare-box{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:13px}.fare-box div{border:1px solid var(--line);background:rgba(255,255,255,.07);padding:12px;border-radius:18px}.fare-box span{display:block;color:var(--muted);font-size:11px;font-weight:800}.fare-box b{font-size:19px;letter-spacing:-.03em}.confirm{margin-top:14px;padding:13px;border-radius:18px;background:linear-gradient(135deg,var(--cyan),var(--blue));color:#061020;text-align:center;font-weight:1000}.mini-stack{position:absolute;right:24px;bottom:26px;display:grid;gap:10px;z-index:4;width:210px}.mini-floating{border:1px solid var(--line);border-radius:20px;background:rgba(5,7,17,.72);backdrop-filter:blur(18px);padding:12px;box-shadow:var(--shadow2)}.mini-floating strong{display:block;font-size:13px}.mini-floating span{display:block;color:var(--muted);font-size:12px;margin-top:3px}.mini-floating b{color:var(--green)}

    .section{padding:34px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:18px}.section-head h2{font-size:clamp(32px,4.7vw,66px);letter-spacing:-.07em;line-height:.92;margin:0;max-width:850px}.section-head p{color:var(--muted);font-size:17px;line-height:1.45;max-width:520px;margin:0}.grid{display:grid;gap:18px}.cols-3{grid-template-columns:repeat(3,1fr)}.cols-4{grid-template-columns:repeat(4,1fr)}.cols-2{grid-template-columns:repeat(2,1fr)}
    .card{border:1px solid var(--line);border-radius:var(--radius2);background:linear-gradient(155deg,rgba(255,255,255,.09),rgba(255,255,255,.045));box-shadow:var(--shadow2);padding:22px;position:relative;overflow:hidden}.card:hover{border-color:rgba(255,255,255,.26);transform:translateY(-2px);transition:.25s ease}.card h3{font-size:24px;letter-spacing:-.04em;margin:0 0 10px}.card p{color:var(--muted);line-height:1.45;margin:0}.card .icon{width:46px;height:46px;border-radius:16px;display:grid;place-items:center;background:rgba(255,255,255,.09);border:1px solid var(--line);font-size:22px;margin-bottom:18px}.tag{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:rgba(255,255,255,.065);padding:7px 10px;border-radius:999px;font-size:12px;color:var(--soft);font-weight:900}.tag.green{color:#cffff0;background:rgba(55,231,161,.11);border-color:rgba(55,231,161,.2)}.tag.gold{color:#fff1c5;background:rgba(255,209,118,.11);border-color:rgba(255,209,118,.22)}.tag.blue{color:#d8ecff;background:rgba(112,167,255,.11);border-color:rgba(112,167,255,.22)}

    .user-lab{display:grid;grid-template-columns:.96fr 1.04fr;gap:18px}.use-case-list{display:grid;gap:12px}.use-case{display:flex;gap:14px;align-items:flex-start;border:1px solid var(--line);border-radius:22px;background:rgba(255,255,255,.06);padding:16px}.use-case b{display:block;font-size:17px;margin-bottom:4px}.use-case span{color:var(--muted);line-height:1.36;font-size:14px}.use-case em{font-style:normal;min-width:42px;height:42px;border-radius:15px;background:rgba(255,255,255,.09);display:grid;place-items:center;border:1px solid var(--line)}
    .mobile-preview{border-radius:30px;padding:20px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.11),rgba(255,255,255,.045));min-height:560px;position:relative;overflow:hidden}.city-radar{position:absolute;inset:20px;border-radius:26px;background:
      radial-gradient(circle at 55% 34%, rgba(55,231,161,.32), transparent 8%),
      radial-gradient(circle at 28% 62%, rgba(255,121,184,.24), transparent 9%),
      radial-gradient(circle at 72% 72%, rgba(112,167,255,.24), transparent 9%),
      linear-gradient(32deg, transparent 0 44%, rgba(255,255,255,.10) 45% 46%, transparent 47%),
      linear-gradient(126deg, transparent 0 38%, rgba(255,255,255,.09) 39% 40%, transparent 41%);
      opacity:.72}.booking-panel{position:absolute;left:38px;right:38px;bottom:36px;border:1px solid var(--line2);border-radius:28px;background:rgba(5,7,17,.78);backdrop-filter:blur(22px);padding:18px;box-shadow:var(--shadow2)}.booking-tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}.booking-tabs span{border:1px solid var(--line);border-radius:16px;padding:10px;text-align:center;color:var(--muted);font-weight:950;font-size:12px;background:rgba(255,255,255,.06)}.booking-tabs span.active{color:#051018;background:linear-gradient(135deg,var(--gold),var(--green));border:0}.booking-row{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding:13px 0}.booking-row:first-of-type{border-top:0}.booking-row span{color:var(--muted);font-size:13px}.booking-row b{letter-spacing:-.03em}.safety-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.safety-strip div{border:1px solid var(--line);border-radius:16px;background:rgba(255,255,255,.06);padding:10px;text-align:center;font-size:12px;color:var(--soft);font-weight:850}.avatar-car{position:absolute;width:78px;height:44px;border-radius:18px;background:linear-gradient(135deg,var(--cyan),var(--blue));box-shadow:0 16px 40px rgba(112,167,255,.24)}.avatar-car:before,.avatar-car:after{content:"";position:absolute;bottom:-7px;width:16px;height:16px;background:#0a1020;border-radius:50%;border:3px solid rgba(255,255,255,.5)}.avatar-car:before{left:13px}.avatar-car:after{right:13px}.avatar-car.one{left:54%;top:31%;transform:rotate(-18deg)}.avatar-car.two{left:23%;top:61%;transform:rotate(14deg);background:linear-gradient(135deg,var(--gold),var(--orange))}.avatar-car.three{right:13%;top:69%;transform:rotate(-4deg);background:linear-gradient(135deg,var(--green),var(--cyan))}

    .vehicle-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}.vehicle{min-height:270px;display:flex;flex-direction:column;justify-content:space-between}.vehicle-visual{height:86px;border-radius:24px;margin:8px 0 18px;position:relative;border:1px solid var(--line);background:linear-gradient(135deg,rgba(255,255,255,.12),rgba(255,255,255,.04));overflow:hidden}.vehicle-visual:before{content:"";position:absolute;left:18%;right:18%;bottom:22px;height:34px;border-radius:22px 22px 9px 9px;background:linear-gradient(135deg,var(--cyan),var(--blue))}.vehicle:nth-child(2) .vehicle-visual:before{background:linear-gradient(135deg,var(--gold),var(--orange))}.vehicle:nth-child(3) .vehicle-visual:before{background:linear-gradient(135deg,var(--green),var(--cyan))}.vehicle-visual:after{content:"";position:absolute;left:26%;right:26%;bottom:14px;height:14px;border-radius:999px;background:rgba(0,0,0,.35);filter:blur(8px)}.checklist{display:grid;gap:9px;margin-top:14px}.checklist div{display:flex;gap:9px;color:var(--soft);font-size:14px}.checklist div:before{content:"✓";color:var(--green);font-weight:1000}

    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.plan{padding:24px;border-radius:28px;border:1px solid var(--line);background:linear-gradient(155deg,rgba(255,255,255,.09),rgba(255,255,255,.045));position:relative;overflow:hidden}.plan.featured{border-color:rgba(255,209,118,.45);background:linear-gradient(155deg,rgba(255,209,118,.14),rgba(255,255,255,.055));box-shadow:0 26px 90px rgba(255,209,118,.1)}.plan .top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.price{font-size:42px;letter-spacing:-.08em;font-weight:1000;margin:16px 0 0}.price small{font-size:14px;color:var(--muted);letter-spacing:0}.plan ul{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:12px}.plan li{color:var(--soft);line-height:1.35;display:flex;gap:9px}.plan li:before{content:"•";color:var(--green);font-weight:1000}.plan .btn{width:100%;margin-top:22px;text-align:center;display:block}.addons{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:18px}.addon{padding:18px;border:1px solid var(--line);border-radius:22px;background:rgba(255,255,255,.058)}.addon b{display:block;margin-bottom:6px}.addon span{color:var(--muted);font-size:13px;line-height:1.35;display:block}

    .package-section{display:grid;grid-template-columns:1fr 1fr;gap:18px}.timeline{display:grid;gap:13px}.step{display:grid;grid-template-columns:48px 1fr;gap:13px;align-items:flex-start}.step-num{width:48px;height:48px;border-radius:17px;background:rgba(255,255,255,.08);border:1px solid var(--line);display:grid;place-items:center;font-weight:1000;color:var(--gold)}.step b{display:block;font-size:18px;margin-bottom:4px}.step span{color:var(--muted);font-size:14px;line-height:1.38}.package-card{min-height:430px}.package-map{height:245px;border:1px solid var(--line);border-radius:26px;margin-top:18px;position:relative;background:
      radial-gradient(circle at 24% 28%,rgba(55,231,161,.33),transparent 9%),
      radial-gradient(circle at 73% 64%,rgba(255,121,184,.28),transparent 10%),
      linear-gradient(30deg,transparent 0 46%,rgba(255,255,255,.12) 47% 48%,transparent 49%),
      linear-gradient(120deg,transparent 0 42%,rgba(255,255,255,.1) 43% 44%,transparent 45%),
      rgba(255,255,255,.045);overflow:hidden}.route-curve{position:absolute;left:25%;top:32%;width:47%;height:42%;border:3px dashed rgba(99,232,255,.72);border-left:0;border-bottom:0;border-radius:0 40px 0 0;transform:rotate(8deg)}.pin{position:absolute;width:18px;height:18px;border-radius:50%;background:var(--green);box-shadow:0 0 0 8px rgba(55,231,161,.14)}.pin.end{background:var(--pink);box-shadow:0 0 0 8px rgba(255,121,184,.14)}.pin.a{left:22%;top:27%}.pin.b{right:23%;bottom:27%}.pod{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.pod div{padding:12px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.06);font-size:12px;color:var(--soft);font-weight:850;text-align:center}

    .fleet-layout{display:grid;grid-template-columns:1.12fr .88fr;gap:18px}.control-panel{min-height:640px}.dashboard-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.segmented{display:flex;gap:6px;background:rgba(255,255,255,.055);border:1px solid var(--line);padding:5px;border-radius:999px}.segmented span{font-size:12px;color:var(--muted);font-weight:950;padding:8px 10px;border-radius:999px}.segmented span.active{background:rgba(255,255,255,.14);color:var(--text)}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kpi{border:1px solid var(--line);border-radius:20px;background:rgba(255,255,255,.058);padding:16px}.kpi span{color:var(--muted);font-size:12px;font-weight:850}.kpi b{display:block;font-size:28px;letter-spacing:-.06em;margin-top:6px}.kpi small{color:var(--green);font-weight:950}.ops-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.ops-card{border:1px solid var(--line);border-radius:22px;background:rgba(255,255,255,.055);padding:16px}.ops-card h4{margin:0 0 12px;font-size:16px}.bar-row{display:grid;grid-template-columns:82px 1fr 48px;gap:10px;align-items:center;margin:10px 0}.bar-row span,.bar-row small{color:var(--muted);font-size:12px}.bar{height:10px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden}.bar i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--green),var(--cyan))}.live-list{display:grid;gap:10px}.live-item{display:flex;align-items:center;justify-content:space-between;gap:12px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.045);padding:12px}.live-item b{font-size:13px}.live-item span{color:var(--muted);font-size:12px}.status-dot{width:10px;height:10px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(55,231,161,.12)}.status-dot.warn{background:var(--gold);box-shadow:0 0 0 5px rgba(255,209,118,.12)}.status-dot.red{background:var(--red);box-shadow:0 0 0 5px rgba(255,100,125,.12)}
    .fleet-map{min-height:640px;position:relative}.map-large{position:absolute;inset:20px;border:1px solid var(--line);border-radius:28px;background:
      radial-gradient(circle at 54% 38%,rgba(55,231,161,.28),transparent 10%),
