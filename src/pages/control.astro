        "Olivia Mobility AI recomienda": "Olivia Mobility AI recommande", "Bolsa de servicios": "Place de services", "Enviar": "Envoyer", "Aplicar": "Appliquer", "Revisar": "Réviser",
        "Olivia Mobility AI:": "Olivia Mobility AI :", "la inteligencia operativa de DUC": "l'intelligence opérationnelle de DUC", "Concierge de movilidad": "Concierge mobilité", "Copiloto del conductor": "Copilote chauffeur", "Dispatcher inteligente": "Dispatcher intelligent",
        "La promesa DUC:": "La promesse DUC :", "más valor para usuarios, socios y empresas": "plus de valeur pour usagers, partenaires et entreprises", "Plataformas tradicionales": "Plateformes traditionnelles", "Una app tradicional te conecta con viajes.": "Une app traditionnelle connecte des trajets.", "DUC conecta viajes, vehículo, paquetes, flotillas y una ruta para crecer.": "DUC connecte trajets, véhicule, colis, flottes et une route pour grandir."
      }
    };

    const originalText = new WeakMap();
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        return node.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      }
    });
    const textNodes = [];
    while (walker.nextNode()) {
      originalText.set(walker.currentNode, walker.currentNode.nodeValue);
      textNodes.push(walker.currentNode);
    }
    function setLanguage(lang) {
      document.documentElement.lang = lang;
      document.querySelectorAll(".lang button").forEach((button) => button.classList.toggle("active", button.dataset.lang === lang));
      textNodes.forEach((node) => {
        const source = originalText.get(node);
        const trimmed = source.trim();
        const translated = lang === "es" ? trimmed : i18n[lang][trimmed];
        if (translated) node.nodeValue = source.replace(trimmed, translated);
        else node.nodeValue = source;
      });
      localStorage.setItem("duc-lang", lang);
    }
    document.querySelectorAll(".lang button").forEach((button) => button.addEventListener("click", () => setLanguage(button.dataset.lang)));
    const menuButton = document.querySelector(".menu-toggle");
    const mobileNav = document.querySelector("#mobile-nav");
    menuButton?.addEventListener("click", () => {
      const expanded = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!expanded));
      mobileNav?.classList.toggle("open", !expanded);
    });
    mobileNav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      menuButton?.setAttribute("aria-expanded", "false");
      mobileNav?.classList.remove("open");
    }));
    setLanguage(localStorage.getItem("duc-lang") || "es");
  </script>
</body>
</html>
