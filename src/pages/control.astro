      linear-gradient(0deg,rgba(255,255,255,.04),rgba(255,255,255,.02));overflow:hidden}.fleet-bubble{position:absolute;border:1px solid var(--line);background:rgba(5,7,17,.73);backdrop-filter:blur(18px);border-radius:18px;padding:10px 12px;box-shadow:var(--shadow2)}.fleet-bubble b{display:block;font-size:13px}.fleet-bubble span{display:block;color:var(--muted);font-size:12px;margin-top:3px}.fleet-bubble.a{left:10%;top:17%}.fleet-bubble.b{right:9%;top:35%}.fleet-bubble.c{left:16%;bottom:18%}.fleet-bubble.d{right:13%;bottom:16%}.fleet-car{position:absolute;width:36px;height:24px;border-radius:11px;background:linear-gradient(135deg,var(--cyan),var(--blue));box-shadow:0 10px 30px rgba(112,167,255,.25)}.fleet-car:nth-child(2n){background:linear-gradient(135deg,var(--gold),var(--orange))}.fleet-car:nth-child(3n){background:linear-gradient(135deg,var(--green),var(--cyan))}

    .comparison{display:grid;grid-template-columns:1fr 1fr;gap:18px}.compare-card{padding:24px;border-radius:28px;border:1px solid var(--line);background:rgba(255,255,255,.055)}.compare-card.duc{border-color:rgba(55,231,161,.34);background:linear-gradient(155deg,rgba(55,231,161,.13),rgba(255,255,255,.045))}.compare-card h3{font-size:30px;letter-spacing:-.05em;margin:0 0 16px}.compare-list{display:grid;gap:12px}.compare-list div{display:flex;gap:10px;color:var(--soft)}.compare-list div:before{content:"—";color:var(--muted);font-weight:1000}.duc .compare-list div:before{content:"✓";color:var(--green)}

