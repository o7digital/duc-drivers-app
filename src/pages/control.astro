        <div class="fleet-layout">
          <article class="card control-panel">
            <div class="dashboard-top">
              <span class="tag gold">Portal B2B / Flotillas</span>
              <div class="segmented"><span class="active">Hoy</span><span>Semana</span><span>Mes</span></div>
            </div>
            <h3 style="font-size:34px;margin-bottom:16px">Gestión de flotillas asignadas</h3>
            <div class="kpis">
              <div class="kpi"><span>Hoteles activos</span><b>38</b><small>+6 este mes</small></div>
              <div class="kpi"><span>Flotillas asignadas</span><b>124</b><small>operativas</small></div>
              <div class="kpi"><span>Viajes corporativos</span><b>1,842</b><small>mes actual</small></div>
