<body>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="#top" aria-label="DUC Drivers MobilityOS">
        <div class="logo">DUC</div>
        <div>
          <div class="brand-title">DUC Drivers MobilityOS</div>
          <div class="brand-sub">App usuario · Socio conductor · Paquetes · Flotillas · Control Center · Olivia AI</div>
        </div>
      </a>
      <button class="menu-toggle" type="button" aria-label="Menu" aria-controls="mobile-nav" aria-expanded="false"><span></span></button>
      <nav class="nav" id="mobile-nav" aria-label="principal">
        <a href="#usuario">Usuario</a>
        <a href="#socios">Socios</a>
        <a href="#paquetes">Paquetes</a>
