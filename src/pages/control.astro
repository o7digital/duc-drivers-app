    @media (max-width:1180px){.hero,.user-lab,.package-section,.fleet-layout,.comparison,.final-cta{grid-template-columns:1fr}.hero-stage{min-height:680px}.hero-pills,.kpis,.addons{grid-template-columns:repeat(2,1fr)}.final-actions{justify-content:flex-start}.topbar{border-radius:28px;align-items:flex-start;flex-wrap:wrap}.menu-toggle{display:grid}.nav{display:none}.nav.open{display:grid;grid-template-columns:1fr;width:100%;gap:8px}.nav.open a{border-color:var(--line);background:rgba(255,255,255,.055)}}
