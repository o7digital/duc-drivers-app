---
import "../styles/global.css";
import Navbar from "../components/Navbar";

interface Props {
  title?: string;
}

const { title = "Mobility OS Mexico" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Demo premium de Mobility OS Mexico para cooperativas, agencias de taxi, transporte ejecutivo, aeropuertos, turismo y Mundial 2026."
    />
    <title>{title}</title>
  </head>
  <body>
    <Navbar client:load />
    <slot />
  </body>
</html>
